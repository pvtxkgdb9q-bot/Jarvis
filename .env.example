# --- Obligatoire en production -------------------------------------------
# Mot de passe de connexion à Jarvis (l'application reste verrouillée sans lui).
JARVIS_PASSWORD=

# --- Lien avec Claude -----------------------------------------------------
# Jeton secret du connecteur MCP : l'URL à donner à Claude est
#   https://<ton-domaine>/api/mcp/<JARVIS_MCP_TOKEN>
JARVIS_MCP_TOKEN=
# Clé API Anthropic pour le chat intégré (console.anthropic.com). Facultatif :
# sans elle, tout fonctionne sauf l'onglet « Jarvis » (le connecteur MCP, lui,
# utilise ton abonnement Claude et n'a pas besoin de clé).
ANTHROPIC_API_KEY=
# Modèle du chat intégré (défaut : claude-opus-5-5).
JARVIS_MODEL=
# « off » désactive la recherche web du chat.
JARVIS_WEB_SEARCH=

# --- Mémoire persistante --------------------------------------------------
# Jeton d'un store Vercel Blob (privé). Ajouté automatiquement quand on
# connecte un store Blob au projet Vercel. Sans lui, les neurones ajoutés
# restent dans le navigateur (localStorage).
BLOB_READ_WRITE_TOKEN=

# --- Synchronisation Vercel en direct (facultatif) ------------------------
# Jeton Vercel (vercel.com/account/tokens) et identifiant d'équipe : Jarvis
# liste alors tes projets Vercel en temps réel au lieu du fichier data/sites.json.
VERCEL_TOKEN=
VERCEL_TEAM_ID=
